rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null && request.auth.uid != null; }
    function uid() { return request.auth.uid; }
    function isOwner(data) { return authed() && data.userId == uid(); }
    function requireOwnerWrite() { return authed() && request.resource.data.userId == uid(); }
    function isAdmin() { return authed() && request.auth.token.email == 'admin@gmail.com'; }

    // USERS
    match /users/{userId} {
      allow read: if authed();
      allow create, update, delete: if authed() && uid() == userId;

      match /cheques/{chequeId} {
        allow read, list: if authed() && uid() == userId;

        allow create: if authed()
          && uid() == userId
          && request.resource.data.issuerUid == uid()
          && request.resource.data.payee is string
          && request.resource.data.amount is number
          && request.resource.data.date is timestamp
          && request.resource.data.bankName is string
          && request.resource.data.status is string
          && request.resource.data.chequeNo is string;

        allow update: if authed()
          && uid() == userId
          && request.resource.data.diff(resource.data).addedKeys().size() == 0
          && request.resource.data.diff(resource.data).removedKeys().size() == 0
          && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['status', 'notes', 'signaturePath']);

        allow delete: if authed() && uid() == userId;
      }

      match /inboxCheques/{chequeId} {
        allow read, list: if authed() && uid() == userId;

        allow create: if authed()
          && request.resource.data.issuerUid is string
          && uid() == request.resource.data.issuerUid
          && request.resource.data.payee is string
          && request.resource.data.amount is number
          && request.resource.data.date is timestamp
          && request.resource.data.bankName is string
          && request.resource.data.status is string
          && request.resource.data.chequeNo is string;

        allow update: if authed()
          && (uid() == userId || uid() == resource.data.issuerUid)
          && request.resource.data.diff(resource.data).addedKeys().size() == 0
          && request.resource.data.diff(resource.data).removedKeys().size() == 0
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']);

        allow delete: if authed() && uid() == userId;
      }
    }

    // CATEGORIES (top-level)
    match /categories/{id} {
      allow read: if isOwner(resource.data);
      allow create: if requireOwnerWrite()
        && request.resource.data.keys().hasAll(['userId','name','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isOwner(resource.data);
    }

    // TRANSACTIONS (top-level)
    match /transactions/{txId} {
      allow read: if isOwner(resource.data);
      allow create: if requireOwnerWrite()
        && request.resource.data.amount is number
        && request.resource.data.direction in ['debit','credit']
        && request.resource.data.status in ['Pending','Completed','Failed']
        && request.resource.data.at is timestamp;
      allow update, delete: if false;
    }

    // BANK USERS (seed/master data)
    match /bankUsers/{docId} {
      allow read: if authed();

      // Admin can manage bank users fully
      allow create, update, delete: if isAdmin();

      // Non-admin updates only permitted for PIN fields by the email owner
      allow update: if authed()
        && request.auth.token.email != null
        && request.auth.token.email == resource.data.email
        && isOnlyPinFieldsUpdated();

      function isOnlyPinFieldsUpdated() {
        let diff = request.resource.data.diff(resource.data);
        let noAddsRemoves = diff.addedKeys().size() == 0 && diff.removedKeys().size() == 0;
        let changed = diff.changedKeys();

        let legacyOk =
          (changed.hasOnly(['transactionPinHash'])) ||
          (changed.hasOnly(['transactionPinSetAt'])) ||
          (changed.hasOnly(['transactionPinHash', 'transactionPinSetAt']));

        let newObjOnly = changed.hasOnly(['transactionPin'])
          && request.resource.data.transactionPin is map
          && request.resource.data.transactionPin.keys().hasOnly(['hash','salt','iterations','algo','setAt'])
          && (request.resource.data.transactionPin.hash is string)
          && (request.resource.data.transactionPin.salt is string)
          && (request.resource.data.transactionPin.iterations is int)
          && (request.resource.data.transactionPin.algo is string)
          && (request.resource.data.transactionPin.setAt is timestamp);

        return noAddsRemoves && (legacyOk || newObjOnly);
      }
    }
  }
}
